{
  "name": "cyber-first-step",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env.local scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:mobile": "node tests/devices.mjs --mobile",
    "test:devices": "node tests/devices.mjs",
    "test:feedback": "node tests/feedback.mjs",
    "test:clipboard": "node tests/clipboard.mjs",
    "test:compare": "node tests/compare.mjs",
    "format": "prettier --write public server api scripts tests content package.json vercel.json README.md docs/maintenance.md .prettierrc.json",
    "format:check": "prettier --check public server api scripts tests content package.json vercel.json README.md docs/maintenance.md .prettierrc.json"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "prettier": "3.9.9"
  }
}
